# ── App ──────────────────────────────────────────────────────────────────────
# URL pública con la que se arman los links de firma (sin barra final).
# En local: http://localhost:3000
# En producción: https://caratulas.tudominio.com
BASE_URL=http://localhost:3000
PORT=3000

# Clave del panel de Yohita. CAMBIAR en producción por una clave larga.
# En producción se recomienda usar ADMIN_PASSWORD_HASH y dejar esta vacía.
ADMIN_PASSWORD=yohita2026
# (En producción, dejar ADMIN_PASSWORD vacía y usar solo el hash.)
# Hash scrypt de la clave. Generarlo con: npm run security:hash
# Formato: scrypt$N$r$p$salt$hash
ADMIN_PASSWORD_HASH=
# Secreto TOTP del doble factor (base32). Generarlo con: npm run security:totp
# Si está vacío, el ingreso pide solo la clave.
ADMIN_TOTP_SECRET=
# Secreto para firmar datos internos (mínimo 32 caracteres aleatorios).
SESSION_SECRET=cambiar-este-secreto-por-uno-largo-y-aleatorio
# Nombre que aparece en el panel.
ADMIN_NAME=Yohita

# Horas de validez del link de firma (por defecto 7 días).
TOKEN_TTL_HOURS=168
# Duración absoluta de una sesión del panel y corte por inactividad.
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# ── Seguridad de red ────────────────────────────────────────────────────────
# En producción: true. Redirige todo a HTTPS y activa HSTS.
FORCE_HTTPS=false
# Cantidad de proxies de confianza delante de la app (Caddy/Nginx = 1).
TRUST_PROXY=1
# Dominios aceptados, separados por coma. Ej.: caratulas.tudominio.com
# Si está vacío, no se valida el Host.
ALLOWED_HOSTS=
# Contacto para el archivo /.well-known/security.txt (email o URL).
SECURITY_CONTACT=

# Zona horaria para sellos de fecha/hora.
TZ=America/Argentina/Buenos_Aires

# ── Almacenamiento ───────────────────────────────────────────────────────────
# Carpetas relativas a la raíz del proyecto (o rutas absolutas).
DB_PATH=data/app.db
UPLOAD_DIR=data/uploads
# Carpeta de respaldos (npm run backup).
BACKUP_DIR=backups

# ── Extracción de datos y resumen con IA ─────────────────────────────────────
# mock | gemini | openrouter
# Con "mock" el agente extrae los datos del CV con heurísticas locales (demo/pruebas).
AI_PROVIDER=mock
AI_MODEL=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Ruta del prompt editable.
AI_PROMPT_FILE=prompts/resumen-candidato.md
# Prompt que usa el agente para extraer los datos del CV.
AI_EXTRACTION_PROMPT_FILE=prompts/extraer-datos.md

# ── Marca ────────────────────────────────────────────────────────────────────
COMPANY_NAME=Grúas San Blas
# La carátula de ingreso GSB es fija. Este archivo sólo define textos legales y de marca.
COVER_TEMPLATE_FILE=templates/caratula.json

# ── WhatsApp (opcional, fase 2) ──────────────────────────────────────────────
# El MVP usa links wa.me. Si se configuran estas variables, el panel puede
# enviar la plantilla automáticamente por WhatsApp Cloud API.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=

# ── Docker (solo docker compose) ─────────────────────────────────────────────
# Dominio que usa Caddy para el certificado HTTPS. Ej.: caratulas.tudominio.com
SITE_ADDRESS=
