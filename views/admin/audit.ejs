<%- include('../partials/head', { title: 'Auditoría', cssFile: 'admin.css' }) %>
<%- include('../partials/admin-nav', { adminName, active: 'auditoria' }) %>

<main class="container">
  <div class="page-head">
    <div>
      <h1>Auditoría</h1>
      <p>Registro de accesos, envíos y firmas. Los últimos 300 eventos.</p>
    </div>
  </div>

  <section class="card security-banner <%= chain.ok ? 'security-banner--ok' : 'security-banner--warn' %>">
    <div class="card__body">
      <div class="security-banner__row">
        <span class="security-banner__icon" aria-hidden="true"><%= chain.ok ? '✓' : '!' %></span>
        <div>
          <strong><%= chain.ok ? 'Cadena de auditoría íntegra' : 'La cadena de auditoría no cierra' %></strong>
          <p class="hint">
            <% if (chain.ok) { %>
              <%= chain.checked %> evento(s) verificados. Cada evento está sellado con el hash del anterior.
              <% if (chain.lastHash) { %> Último sello: <span class="mono"><%= shortHash(chain.lastHash) %></span>.<% } %>
            <% } else { %>
              Se detectó un problema en el evento <%= chain.brokenAt %>: <%= chain.reason %> Revisá la base y los respaldos.
            <% } %>
          </p>
        </div>
        <a class="btn btn--ghost btn--sm" href="/admin/seguridad">Centro de seguridad</a>
      </div>
    </div>
  </section>

  <section class="card">
    <div class="card__body">
      <% if (rows.length === 0) { %>
        <p class="muted">Todavía no hay eventos registrados.</p>
      <% } else { %>
        <ul class="audit">
          <% rows.forEach(function (a) { %>
            <li>
              <span class="audit__mark <%= /firm|login|pdf/.test(a.event) ? 'audit__mark--key' : '' %>"></span>
              <div>
                <div class="audit__event">
                  <%= a.event.replaceAll('_', ' ') %>
                  <% if (a.full_name) { %>
                    · <a href="/admin/candidatos/<%= a.candidate_id %>"><%= a.full_name %></a>
                  <% } %>
                </div>
                <% if (a.detail) { %><div class="audit__detail"><%= a.detail %></div><% } %>
                <div class="audit__when">
                  <%= formatDateTime(a.created_at) %>
                  <% if (a.ip) { %> · <%= a.ip %><% } %>
                  <% if (a.user_agent) { %> · <%= a.user_agent.slice(0, 80) %><% } %>
                </div>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </section>
</main>

<%- include('../partials/foot', { jsFile: 'admin.js' }) %>
