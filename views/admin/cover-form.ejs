<%- include('../partials/head', { title: `Carátula · ${candidate.full_name}`, cssFile: 'admin.css' }) %>
<%- include('../partials/admin-nav', { adminName, active: 'panel' }) %>

<main class="container">
  <div class="breadcrumb">
    <a href="/admin">Candidatos</a><span>/</span>
    <a href="/admin/candidatos/<%= candidate.id %>"><%= candidate.full_name %></a><span>/</span>
    <span>Carátula GSB</span>
  </div>

  <% if (error) { %>
    <div class="flash flash--warn" style="margin-top:18px"><%= error %></div>
  <% } %>
  <% if (ok === 'foto') { %><div class="flash" style="margin-top:18px">Foto del ingreso actualizada.</div><% } %>
  <% if (ok === 'sin-foto') { %><div class="flash" style="margin-top:18px">No hay foto cargada.</div><% } %>
  <% if (ok === 'foto-invalida') { %><div class="flash flash--warn" style="margin-top:18px">La foto tiene que ser JPG o PNG de hasta 5 MB.</div><% } %>

  <header class="cand-head">
    <span class="thumb cand-head__avatar"><%= candidate.full_name.slice(0, 1).toUpperCase() %></span>
    <div>
      <h1>Carátula de Ingreso GSB</h1>
      <p class="cand-head__meta">Completá los datos que faltan del CV. La carátula se guarda automáticamente en tiempo real.</p>
    </div>
    <div class="cand-head__actions">
      <span id="cover-save-status" style="font-size:12px;font-weight:700;color:#16a34a;margin-right:8px;display:inline-flex;align-items:center;gap:4px">✓ Guardado automático activo</span>
      <a class="btn btn--ghost btn--sm" href="/admin/candidatos/<%= candidate.id %>">Volver al expediente</a>
      <a class="btn btn--ghost btn--sm" href="/admin/candidatos/<%= candidate.id %>/pdf" target="_blank" rel="noopener">Ver PDF</a>
    </div>
  </header>

  <div id="local-draft-banner" class="flash flash--info" style="display:none; margin-top:18px; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;">
    <div>
      <strong>💾 Borrador detectado en este navegador:</strong>
      <span id="local-draft-info">Tenés campos guardados previamente en esta computadora.</span>
    </div>
    <div style="display:flex; gap:8px;">
      <button type="button" class="btn btn--sm" id="restore-local-draft-btn">Aplicar borrador guardado</button>
      <button type="button" class="btn btn--ghost btn--sm" id="discard-local-draft-btn">Ocultar</button>
    </div>
  </div>

  <% if (!completeness.complete) { %>
    <div class="flash flash--warn" style="margin-top:18px">
      <strong>Faltan datos para enviar a firmas:</strong>
      <%= completeness.required.join(' · ') %>.
    </div>
  <% } %>

  <!-- Foto del ingreso -->
  <section class="card" style="margin-top:18px">
    <div class="card__head">
      <div>
        <h2>Foto del ingreso</h2>
        <p>JPG o PNG de hasta 5 MB. Se muestra en la carátula y en el PDF. Guardado persistente en la nube.</p>
      </div>
      <div id="photo-save-badge" style="font-size:12px;font-weight:700;color:#16a34a;display:none"></div>
    </div>
    <div class="card__body gsb-photo-admin">
      <div class="gsb-photo<%= (candidate.photo_data || candidate.photo_path) ? ' gsb-photo--con-foto' : '' %>" id="gsb-photo-box">
        <% if (candidate.photo_data || candidate.photo_path) { %>
          <img id="gsb-photo-img" src="/admin/candidatos/<%= candidate.id %>/foto?v=<%= Date.now() %>" alt="Foto de <%= candidate.full_name %>">
        <% } else { %>
          <div class="gsb-photo__placeholder" id="gsb-photo-placeholder" aria-hidden="true">
            <span class="gsb-photo__icon">＋</span>
            <span class="gsb-photo__tx">Foto del ingreso</span>
          </div>
        <% } %>
      </div>
      <div class="stack" style="gap:10px">
        <form id="gsb-photo-form" method="post" action="/admin/candidatos/<%= candidate.id %>/foto" enctype="multipart/form-data" class="share" style="max-width:520px">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input class="input" type="file" id="photo-file-input" name="photo" accept="image/png,image/jpeg" required>
          <button class="btn btn--sm" id="photo-upload-btn" type="submit">Subir foto</button>
        </form>
        <form id="gsb-photo-delete-form" method="post" action="/admin/candidatos/<%= candidate.id %>/foto/eliminar" style="<%= (candidate.photo_data || candidate.photo_path) ? '' : 'display:none;' %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--ghost btn--sm" type="submit">Quitar foto</button>
        </form>
      </div>
    </div>
  </section>

  <form id="gsb-cover-form" class="gsb-form" method="post" action="/admin/candidatos/<%= candidate.id %>/caratula" style="margin-top:18px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <section class="gsb-sec">
      <div class="gsb-sec__title"><span class="gsb-num">1</span> Datos del postulante</div>
      <div class="gsb-sec__body">
        <div class="gsb-grid gsb-g2">
          <div class="gsb-field gsb-field--full">
            <label class="gsb-field__label" for="c-name">Postulante (apellido, nombre) *</label>
            <input class="input" id="c-name" name="full_name" value="<%= gsb.full_name %>" maxlength="140" required placeholder="APELLIDO, NOMBRE">
          </div>
          <div class="gsb-field">
            <label class="gsb-field__label" for="c-age">Edad</label>
            <input class="input" id="c-age" name="age" value="<%= gsb.age %>" maxlength="40" placeholder="Ej.: 31 años">
          </div>
          <div class="gsb-field">
            <label class="gsb-field__label" for="c-branch">Sucursal / Localidad *</label>
            <select class="input" id="c-branch" name="branch" required>
              <option value="">Elegir sucursal</option>
              <% GSB_BRANCHES.forEach(function (branch) { %>
                <option value="<%= branch %>" <%= gsb.branch === branch ? 'selected' : '' %>><%= branch %></option>
              <% }) %>
            </select>
          </div>
          <div class="gsb-field">
            <label class="gsb-field__label" for="c-selected">Seleccionado por</label>
            <input class="input" id="c-selected" name="selected_by" value="<%= gsb.selected_by %>" maxlength="140" placeholder="APELLIDO, NOMBRE">
          </div>
          <div class="gsb-field">
            <label class="gsb-field__label" for="c-test">Prueba técnica</label>
            <input class="input" id="c-test" name="technical_test" value="<%= gsb.technical_test %>" maxlength="120" placeholder="Resultado / N/A">
          </div>
          <div class="gsb-field">
            <label class="gsb-field__label" for="c-fit">Fit cultural</label>
            <input class="input" id="c-fit" name="cultural_fit" value="<%= gsb.cultural_fit %>" maxlength="80" placeholder="Ej.: 8/10">
          </div>
          <div class="gsb-field">
            <label class="gsb-field__label" for="c-function">Función</label>
            <input class="input" id="c-function" name="job_function" value="<%= gsb.job_function %>" maxlength="140" placeholder="Ej.: Asesor">
          </div>
          <div class="gsb-field">
            <label class="gsb-field__label" for="c-sector">Sector</label>
            <input class="input" id="c-sector" name="sector" value="<%= gsb.sector %>" maxlength="120" placeholder="Ej.: Repuestos">
          </div>
          <div class="gsb-field">
            <label class="gsb-field__label" for="c-area">Área</label>
            <input class="input" id="c-area" name="area" value="<%= gsb.area %>" maxlength="140" placeholder="Ej.: Comercial">
          </div>
          <div class="gsb-field">
            <label class="gsb-field__label" for="c-national">Responsable nacional</label>
            <input class="input" id="c-national" name="national_manager" value="<%= gsb.national_manager %>" maxlength="140" placeholder="APELLIDO, NOMBRE">
          </div>
          <div class="gsb-field">
            <label class="gsb-field__label" for="c-bmanager">Responsable sector / sucursal</label>
            <input class="input" id="c-bmanager" name="branch_manager" value="<%= gsb.branch_manager %>" maxlength="140" placeholder="APELLIDO, NOMBRE">
          </div>
          <div class="gsb-field">
            <label class="gsb-field__label" for="c-leader">Líder / Tutor directo</label>
            <input class="input" id="c-leader" name="direct_leader" value="<%= gsb.direct_leader %>" maxlength="140" placeholder="APELLIDO, NOMBRE">
          </div>
        </div>
      </div>
    </section>

    <section class="gsb-sec">
      <div class="gsb-sec__title"><span class="gsb-num">2</span> Fuentes de reclutamiento</div>
      <div class="gsb-sec__body">
        <div class="gsb-grid gsb-g2 gsb-sources-layout">
          <div class="gsb-medios">
            <% GSB_SOURCES.forEach(function (source) { %>
              <% const checked = (gsb.sources || []).includes(source); %>
              <label class="gsb-medio<%= checked ? ' gsb-medio--on' : '' %>">
                <input type="checkbox" name="recruitment_sources" value="<%= source %>" <%= checked ? 'checked' : '' %>>
                <span class="gsb-check<%= checked ? ' gsb-check--on' : '' %>" aria-hidden="true"></span>
                <span><%= source %></span>
              </label>
            <% }) %>
          </div>
          <div>
            <div class="gsb-field">
              <div class="gsb-field__label">Tipo de puesto</div>
              <div class="gsb-toggle-edit">
                <label><input type="radio" name="position_type" value="nuevo" <%= gsb.position_type === 'nuevo' ? 'checked' : '' %>><span>Puesto nuevo</span></label>
                <label><input type="radio" name="position_type" value="reemplazo" <%= gsb.position_type === 'reemplazo' ? 'checked' : '' %>><span>Reemplazo</span></label>
              </div>
            </div>
            <div class="gsb-field gsb-only-reemplazo">
              <label class="gsb-field__label" for="c-replaces">Reemplaza a (apellido, nombre)</label>
              <input class="input" id="c-replaces" name="replaces_name" value="<%= gsb.replaces_name %>" maxlength="140" placeholder="APELLIDO, NOMBRE">
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="gsb-sec">
      <div class="gsb-sec__title"><span class="gsb-num">3</span> Condiciones de contratación</div>
      <div class="gsb-sec__body">
        <div class="gsb-grid gsb-g3">
          <div class="gsb-field">
            <label class="gsb-field__label" for="c-agreement">Categoría convenio</label>
            <input class="input" id="c-agreement" name="agreement_category" value="<%= gsb.agreement_category %>" maxlength="120" placeholder="Ej.: Vendedor A">
          </div>
          <div class="gsb-field">
            <label class="gsb-field__label" for="c-gsbcat">Categoría Grúas San Blas</label>
            <input class="input" id="c-gsbcat" name="gsb_category" value="<%= gsb.gsb_category %>" maxlength="80" placeholder="Ej.: 6.5">
          </div>
          <div class="gsb-field">
            <label class="gsb-field__label" for="c-schedule">Horario</label>
            <input class="input" id="c-schedule" name="schedule" value="<%= gsb.schedule %>" maxlength="120" placeholder="Ej.: 8.00 a 18 hs">
          </div>
          <div class="gsb-field">
            <label class="gsb-field__label" for="c-cct">CCT</label>
            <input class="input" id="c-cct" name="cct" value="<%= gsb.cct %>" maxlength="120" placeholder="Ej.: Comercio">
          </div>
          <div class="gsb-field">
            <label class="gsb-field__label" for="c-overtime">Horas extra</label>
            <select class="input" id="c-overtime" name="overtime">
              <option value="">—</option>
              <option value="NO" <%= gsb.overtime === 'NO' ? 'selected' : '' %>>NO</option>
              <option value="SI" <%= gsb.overtime === 'SI' ? 'selected' : '' %>>SI</option>
            </select>
          </div>
          <div class="gsb-field">
            <label class="gsb-field__label" for="c-card">Tarjeta corporativa</label>
            <select class="input" id="c-card" name="corporate_card">
              <option value="">—</option>
              <option value="NO" <%= gsb.corporate_card === 'NO' ? 'selected' : '' %>>NO</option>
              <option value="SI" <%= gsb.corporate_card === 'SI' ? 'selected' : '' %>>SI</option>
            </select>
          </div>
          <div class="gsb-field">
            <label class="gsb-field__label" for="c-gross">Sueldo bruto ($)</label>
            <input class="input" id="c-gross" name="gross_salary" value="<%= gsb.gross_salary %>" maxlength="40" inputmode="numeric" placeholder="0">
          </div>
          <div class="gsb-field">
            <label class="gsb-field__label" for="c-net">Sueldo neto ($)</label>
            <input class="input" id="c-net" name="net_salary" value="<%= gsb.net_salary %>" maxlength="40" inputmode="numeric" placeholder="0">
          </div>
          <div class="gsb-field">
            <label class="gsb-field__label" for="c-va">Valor agregado (%)</label>
            <input class="input" id="c-va" name="value_added" value="<%= gsb.value_added %>" maxlength="40" inputmode="decimal" placeholder="0,00">
          </div>
          <div class="gsb-field gsb-field--full">
            <label class="gsb-field__label" for="c-obs">Observaciones</label>
            <textarea class="textarea" id="c-obs" name="observations" rows="3" maxlength="500" placeholder="Ej.: Prepaga + vehículo asignado + notebook + esquema de comisiones"><%= gsb.observations %></textarea>
          </div>
        </div>
      </div>
    </section>

    <div class="gsb-form__actions">
      <a class="btn btn--ghost" href="/admin/candidatos/<%= candidate.id %>">Volver</a>
      <button class="btn" id="btn-save-cover" type="submit">Guardar carátula</button>
    </div>
  </form>
</main>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
document.addEventListener('DOMContentLoaded', function() {
  const CANDIDATE_ID = <%= candidate.id %>;
  const csrfToken = document.querySelector('input[name="_csrf"]')?.value || document.querySelector('meta[name="csrf-token"]')?.content || '';
  const form = document.getElementById('gsb-cover-form');
  const statusEl = document.getElementById('cover-save-status');

  if (!form) return;

  // 1. Restaurar borrador de localStorage si existe
  const draftBanner = document.getElementById('local-draft-banner');
  const restoreDraftBtn = document.getElementById('restore-local-draft-btn');
  const discardDraftBtn = document.getElementById('discard-local-draft-btn');

  try {
    const localDraft = localStorage.getItem('gsb_cover_' + CANDIDATE_ID);
    if (localDraft) {
      const parsed = JSON.parse(localDraft);
      if (parsed && typeof parsed === 'object') {
        const filledKeys = Object.keys(parsed).filter(function(k) {
          const v = parsed[k];
          return v !== null && v !== undefined && v !== '' && (!Array.isArray(v) || v.length > 0);
        });

        if (filledKeys.length > 0) {
          if (draftBanner) draftBanner.style.display = 'flex';

          function applyDraft() {
            Object.entries(parsed).forEach(function([name, val]) {
              if (!name || val === undefined) return;
              const el = form.elements[name];
              if (!el) return;
              if (el instanceof RadioNodeList || el.type === 'radio') {
                const radio = form.querySelector('input[name="' + name + '"][value="' + val + '"]');
                if (radio) radio.checked = true;
              } else if (el.type === 'checkbox') {
                if (Array.isArray(val)) {
                  form.querySelectorAll('input[name="' + name + '"]').forEach(function(cb) {
                    cb.checked = val.includes(cb.value);
                  });
                } else {
                  el.checked = Boolean(val);
                }
              } else if (val) {
                el.value = val;
              }
            });
            triggerAutoSave();
            if (draftBanner) {
              draftBanner.className = 'flash flash--info';
              draftBanner.innerHTML = '<strong>✓ Borrador aplicado con éxito.</strong> Los datos se sincronizaron con el servidor.';
              setTimeout(function() { draftBanner.style.display = 'none'; }, 4000);
            }
          }

          // Aplicar automáticamente para recuperar cualquier dato no guardado
          applyDraft();

          if (restoreDraftBtn) restoreDraftBtn.onclick = applyDraft;
          if (discardDraftBtn) discardDraftBtn.onclick = function() {
            if (draftBanner) draftBanner.style.display = 'none';
          };
        }
      }
    }
  } catch (e) {}

  function collectFormData() {
    const data = {};
    const elements = form.elements;
    const sources = [];

    for (let i = 0; i < elements.length; i++) {
      const el = elements[i];
      if (!el.name || el.name === '_csrf') continue;
      if (el.type === 'radio') {
        if (el.checked) data[el.name] = el.value;
      } else if (el.type === 'checkbox') {
        if (el.name === 'recruitment_sources') {
          if (el.checked) sources.push(el.value);
        } else {
          data[el.name] = el.checked;
        }
      } else {
        data[el.name] = el.value;
      }
    }
    data.recruitment_sources = sources;
    return data;
  }

  let autoSaveTimer = null;
  function triggerAutoSave() {
    const data = collectFormData();
    try {
      localStorage.setItem('gsb_cover_' + CANDIDATE_ID, JSON.stringify(data));
    } catch (e) {}

    if (statusEl) {
      statusEl.innerHTML = '<span style="color:#d97706">⏳ Guardando automáticamente...</span>';
    }

    clearTimeout(autoSaveTimer);
    autoSaveTimer = setTimeout(function() {
      fetch('/admin/candidatos/' + CANDIDATE_ID + '/caratula/autosave', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
          ...(csrfToken ? { 'x-csrf-token': csrfToken } : {})
        },
        body: JSON.stringify(data)
      })
      .then(function(res) { return res.json(); })
      .then(function(res) {
        if (res.ok && statusEl) {
          statusEl.innerHTML = '<span style="color:#16a34a">✓ Guardado automático (' + (res.savedAt || 'activo') + ')</span>';
        }
      })
      .catch(function() {
        if (statusEl) {
          statusEl.innerHTML = '<span style="color:#ef4444">⚠️ Error al autoguardar (se reintentará)</span>';
        }
      });
    }, 1000);
  }

  form.addEventListener('input', triggerAutoSave);
  form.addEventListener('change', triggerAutoSave);

  // Manejo de envío manual para que nunca te saque de la pantalla si hay error de red
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    clearTimeout(autoSaveTimer);
    const saveBtn = document.getElementById('btn-save-cover');
    if (saveBtn) {
      saveBtn.disabled = true;
      saveBtn.textContent = 'Guardando...';
    }
    const data = collectFormData();
    try {
      localStorage.setItem('gsb_cover_' + CANDIDATE_ID, JSON.stringify(data));
    } catch (e) {}

    fetch('/admin/candidatos/' + CANDIDATE_ID + '/caratula/autosave', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest',
        ...(csrfToken ? { 'x-csrf-token': csrfToken } : {})
      },
      body: JSON.stringify(data)
    })
    .then(function(res) {
      if (res.status === 401) {
        throw new Error('Sesión vencida. Los datos quedaron a salvo en tu pantalla.');
      }
      return res.json();
    })
    .then(function(res) {
      if (res.ok) {
        if (statusEl) statusEl.innerHTML = '<span style="color:#16a34a">✓ Guardado correctamente</span>';
        if (saveBtn) saveBtn.textContent = '✓ Guardado';
        window.location.href = '/admin/candidatos/' + CANDIDATE_ID + '?ok=caratula';
      } else {
        throw new Error(res.error || 'Error al guardar');
      }
    })
    .catch(function(err) {
      if (saveBtn) {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Guardar carátula';
      }
      if (statusEl) {
        statusEl.innerHTML = '<span style="color:#ef4444">⚠️ ' + (err.message || 'Error al guardar') + '</span>';
      }
      alert('Aviso: ' + (err.message || 'Hubo un problema de conexión. Tus datos están preservados en el formulario.'));
    });
  });

  // 2. Manejo asíncrono de foto sin recargar la página (así nunca se pierden los campos de texto)
  const photoForm = document.getElementById('gsb-photo-form');
  const photoInput = document.getElementById('photo-file-input');
  const photoBox = document.getElementById('gsb-photo-box');
  const photoBadge = document.getElementById('photo-save-badge');
  const photoDeleteForm = document.getElementById('gsb-photo-delete-form');

  function uploadPhotoAsync(file) {
    if (!file) return;
    if (photoBadge) {
      photoBadge.style.display = 'inline-block';
      photoBadge.style.color = '#d97706';
      photoBadge.textContent = '⏳ Guardando foto...';
    }

    const formData = new FormData();
    formData.append('_csrf', csrfToken);
    formData.append('photo', file);

    fetch('/admin/candidatos/' + CANDIDATE_ID + '/foto', {
      method: 'POST',
      headers: {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
      },
      body: formData
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.ok) {
        if (photoBadge) {
          photoBadge.style.color = '#16a34a';
          photoBadge.textContent = '✓ Foto guardada y protegida en la nube';
          setTimeout(function() { photoBadge.style.display = 'none'; }, 4000);
        }
        if (photoDeleteForm) photoDeleteForm.style.display = '';
        triggerAutoSave();
      } else {
        throw new Error(data.error || 'Error al subir');
      }
    })
    .catch(function(err) {
      if (photoBadge) {
        photoBadge.style.color = '#ef4444';
        photoBadge.textContent = '⚠️ ' + (err.message || 'Error al guardar foto');
      }
    });
  }

  if (photoInput) {
    photoInput.addEventListener('change', function() {
      const file = photoInput.files && photoInput.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        photoBox.classList.add('gsb-photo--con-foto');
        photoBox.innerHTML = '<img id="gsb-photo-img" src="' + e.target.result + '" alt="Foto">';
      };
      reader.readAsDataURL(file);

      uploadPhotoAsync(file);
    });
  }

  if (photoForm) {
    photoForm.addEventListener('submit', function(e) {
      e.preventDefault();
      const file = photoInput.files && photoInput.files[0];
      if (file) uploadPhotoAsync(file);
    });
  }

  if (photoDeleteForm) {
    photoDeleteForm.addEventListener('submit', function(e) {
      e.preventDefault();
      if (!confirm('¿Quitar la foto del ingreso?')) return;

      fetch('/admin/candidatos/' + CANDIDATE_ID + '/foto/eliminar', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'X-Requested-With': 'XMLHttpRequest',
          'Accept': 'application/json'
        },
        body: '_csrf=' + encodeURIComponent(csrfToken)
      })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.ok) {
          photoBox.classList.remove('gsb-photo--con-foto');
          photoBox.innerHTML = '<div class="gsb-photo__placeholder" aria-hidden="true"><span class="gsb-photo__icon">＋</span><span class="gsb-photo__tx">Foto del ingreso</span></div>';
          photoDeleteForm.style.display = 'none';
          if (photoBadge) {
            photoBadge.style.display = 'inline-block';
            photoBadge.style.color = '#16a34a';
            photoBadge.textContent = '✓ Foto eliminada';
            setTimeout(function() { photoBadge.style.display = 'none'; }, 3000);
          }
        }
      });
    });
  }
});
</script>

